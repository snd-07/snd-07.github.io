---
// src/components/Header.astro
interface Props {
  showContact?: boolean;
}
const { showContact = true } = Astro.props;
---

<header class="fixed sticky w-full bg-white/80 top-0">
  {showContact ? (
    <div class="mx-auto max-w-[61.25rem] w-full px-4 flex justify-between self-center py-4 items-center">
      <h1><a href="/">sono's portfolio</a></h1>
      <a href="https://docs.google.com/forms/d/e/1FAIpQLSelWaegh7DgBhQTTpjMn9EEuv5BH91nqlxNjvp2gBtHboSSpA/viewform?usp=preview"
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-3xl border-black border-solid border py-2 px-6 inline-block inline-flex items-center transition-colors duration-300 ease-in-out bg-white text-black hover:bg-black hover:text-white md:px-8">お問い合わせ</a>
    </div>
  ) : (
    <div class="mx-auto max-w-[61.25rem] w-full px-4">
      <h1 class="pt-8 pb-8"><a href="/">sono's portfolio</a></h1>
    </div>
  )}
</header>