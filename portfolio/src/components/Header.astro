---
// src/components/Header.astro
interface Props {
  showContact?: boolean;
}
const { showContact = true } = Astro.props;
---

<header class="site-header">
  {showContact ? (
    <div class="header-pill header-nav">
      <h1><a href="/">sono's portfolio</a></h1>
      <a href="https://docs.google.com/forms/d/e/1FAIpQLSelWaegh7DgBhQTTpjMn9EEuv5BH91nqlxNjvp2gBtHboSSpA/viewform?usp=preview"
      target="_blank"
      rel="noopener noreferrer"
      class="contact-btn">お問い合わせ</a>
    </div>
  ) : (
    <div class="header-pill header-logo">
      <h1><a href="/">sono's portfolio</a></h1>
    </div>
  )}
</header>

<style>
  .site-header {
    position: sticky;
    top: 2rem;
    z-index: 50;
  }

  @media (min-width: 768px) {
    .header-pill {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  .header-pill {
    width: calc(100% - 4rem);
    margin-left: auto;
    margin-right: auto;
    max-width: 61.25rem;
    background-color: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(4px);
    border-radius: 0.8rem;
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .header-nav {
    padding-top: 1.4rem;
    padding-bottom: 1.4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .header-logo {
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .contact-btn {
    border-radius: 0.4rem;
    padding: 0.4rem 1.2rem;
    display: inline-flex;
    align-items: center;
    background-color: #fff;
    color: #000;
    text-decoration: none;
    transition: background-color 0.3s ease-in-out, color 0.3s ease-in-out;
    &:hover {
        background-color: #000;
        color: #fff;
    }
  }

</style>