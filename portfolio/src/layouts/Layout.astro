---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
	title?: string;
	showContact?: boolean;
}
const { title = "sono's portfolio", showContact = true } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
	    <title>{title}</title>
		<slot name="head" />
	</head>
	<body>
		<Header showContact={showContact} />
		<slot />
		<Footer />
	</body>
</html>

<style is:global>
	/* Tailwind preflight 相当のリセット */
	*,
	*::before,
	*::after {
		box-sizing: border-box;
		border-width: 0;
		border-style: solid;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		font-family: sans-serif;
		letter-spacing: 0.1em;
		background-color: #F7F9FA;
		font-feature-settings: "palt";
		line-height: inherit;
	}

	/* 見出しのデフォルト margin / font-size を除去 */
	h1, h2, h3, h4, h5, h6 {
		font-size: inherit;
		font-weight: inherit;
		margin: 0;
	}

	/* p, blockquote, dl, dd の margin を除去 */
	p, blockquote, dl, dd, figure, pre {
		margin: 0;
	}

	/* リストのデフォルトスタイルを除去 */
	ul, ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* リンクのデフォルトスタイルを除去 */
	a {
		color: inherit;
		text-decoration: inherit;
	}

	/* 画像・メディアをブロック要素に */
	img, svg, video, canvas, audio, iframe, embed, object {
		display: block;
		vertical-align: middle;
	}

	img, video {
		max-width: 100%;
		height: auto;
	}

	/* フォーム要素のフォントをページに合わせる */
	button, input, optgroup, select, textarea {
		font-family: inherit;
		font-size: 100%;
		font-weight: inherit;
		line-height: inherit;
		color: inherit;
		margin: 0;
		padding: 0;
	}

	button {
		background-color: transparent;
		background-image: none;
		cursor: pointer;
	}
</style>
