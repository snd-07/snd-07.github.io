---
import Layout from '../layouts/Layout.astro';
import articles from '../data/articles.json';
import icon from '../assets/icon.webp';
import type { ImageMetadata } from 'astro';

const isExternal = (url: string) => url.startsWith('http');

const assetImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/**/*.{png,jpg,jpeg,webp}',
  { eager: true }
);
const resolveImage = (imgSrc: string) =>
  assetImages[imgSrc.replace('/images', '../assets')].default.src;

const allTags = [...new Set(articles.works.flatMap((item) => item.tags))];
---

<Layout title="sono's portfolio" showContact={true}>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;700;900&display=swap" />
  <div class="page-wrapper">
    <section class="hero">
      <p class="hero-sub">web designer</p>
      <p class="hero-title">sono's portfolio</p>
      <p class="hero-text">名古屋市在住のWebデザイナー。<br>UIデザイン、HTML、CSSが好きです。</p>
      <div class="btn-group">
        <a href="/profile.html" class="profile-btn">プロフィール</a>
        <a href="https://docs.google.com/forms/d/e/1FAIpQLSelWaegh7DgBhQTTpjMn9EEuv5BH91nqlxNjvp2gBtHboSSpA/viewform?usp=preview" target="_blank" rel="noopener noreferrer" class="profile-btn">制作事例</a>
      </div>
    </section>
    <section class="works-section">
      <h2 class="section-title">制作・執筆</h2>
      <div class="filter-bar" id="filter-bar">
        <button class="filter-btn active" data-tag="all">すべて</button>
        {allTags.map((tag) => (
          <button class="filter-btn" data-tag={tag}>{tag}</button>
        ))}
      </div>
      <ul class="posts-list" id="works-grid">
        {articles.works.map((item) => (
          <li class="post-card" data-tags={item.tags.join(',')}>
            <a href={item.href} target={isExternal(item.href) ? '_blank' : undefined} rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}>
              <div class="post-img-wrap">
                <img src={resolveImage(item.imgSrc)} class="post-img" />
                <span class="post-label">{item.label}</span>
              </div>
              <div class="post-body">
                <div class="post-meta-row">
                  <h3 class="post-title">{item.title}</h3>
                  <span class="post-year">{item.year}</span>
                </div>
                <p class="post-source">{item.source}</p>
                <p class="post-desc">{item.description}</p>
                <ul class="post-tags">
                  {item.tags.map((tag) => (
                    <li class="post-tag">{tag}</li>
                  ))}
                </ul>
                <span class="post-link">詳しく見る →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('#filter-bar .filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('#works-grid .post-card');
  const activeTags = new Set<string>();

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag!;

      if (tag === 'all') {
        activeTags.clear();
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
      } else {
        document.querySelector<HTMLButtonElement>('#filter-bar .filter-btn[data-tag="all"]')?.classList.remove('active');
        if (activeTags.has(tag)) {
          activeTags.delete(tag);
          btn.classList.remove('active');
          if (activeTags.size === 0) {
            document.querySelector<HTMLButtonElement>('#filter-bar .filter-btn[data-tag="all"]')?.classList.add('active');
          }
        } else {
          activeTags.add(tag);
          btn.classList.add('active');
        }
      }

      cards.forEach((card) => {
        if (activeTags.size === 0) {
          card.style.display = '';
        } else {
          const cardTags = card.dataset.tags?.split(',') ?? [];
          card.style.display = [...activeTags].some((t) => cardTags.includes(t)) ? '' : 'none';
        }
      });
    });
  });
</script>

<style>
  .page-wrapper {
    margin: 9rem auto 8rem;
    max-width: 61.25rem;
    width: 100%;
    padding: 0 1rem;
  }

  .hero {
    height: 20rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    row-gap: 0.8rem;
  }

  .hero-sub {
    font-family: 'Archivo', sans-serif;
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1;
  }

  .hero-title {
    font-family: 'Archivo', sans-serif;
    font-size: 6rem;
    font-weight: 900;
    word-break: break-all;
    line-height: 1;
  }

  .hero-text {
    margin-top: 2rem;
    font-size: 1rem;
  }

  .section {
    margin-top: 6rem;
  }

  @media (min-width: 768px) {
    .section {
      margin-top: 10rem;
    }
  }

  .section-title {
    font-size: 1.875rem;
    font-weight: 700;
  }

  .article-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem 0.75rem;
    margin-top: 1.5rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 768px) {
    .article-list {
      grid-template-columns: repeat(3, 1fr);
      gap: 4rem 0.75rem;
      margin-top: 2.25rem;
    }
  }

  .article-list a {
    text-decoration: none;
    color: inherit;
  }

  .article-img {
    border-radius: 0.5rem;
    width: 100%;
    height: auto;
  }

  .article-title {
    margin-top: 1rem;
    font-weight: 700;
    font-size: 1rem;
  }

  .article-meta {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: #9ca3af;
  }

  .about-inner {
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-start;
    justify-content: space-between;
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .about-inner {
      flex-direction: row;
      align-items: center;
      margin-top: 0;
    }
  }

  .about-text {
    margin-top: 2.5rem;
  }

  .btn-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 5.2rem;
  }

  .profile-btn {
    border-radius: 0.2rem;
    border: 1px solid #000;
    padding: 0.75rem 2rem;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.3s ease-in-out, color 0.3s ease-in-out;
    &:hover {
    background-color: #000;
    color: #fff;
  }
  }

  .btn-arrow {
    margin-left: 0.25rem;
  }

  .avatar {
    border-radius: 9999px;
  }

  /* 統合一覧 */
  .works-section {
    margin-top: 6rem;
  }

  @media (min-width: 768px) {
    .works-section {
      margin-top: 10rem;
    }
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .filter-btn {
    font-size: 0.75rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 0.25rem;
    background: transparent;
    color: #374151;
    cursor: pointer;
    font-family: inherit;
    transition: background-color 0.15s, color 0.15s, border-color 0.15s;
  }

  .filter-btn:hover {
    border-color: #000;
  }

  .filter-btn.active {
    background-color: #000;
    color: #fff;
    border-color: #000;
  }

  .posts-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 768px) {
    .posts-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .post-card {
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .post-card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .post-img-wrap {
    position: relative;
  }

  .post-img {
    width: 100%;
    height: 11rem;
    object-fit: cover;
    display: block;
  }

  .post-label {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background-color: rgba(255, 255, 255, 0.92);
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    letter-spacing: 0.04em;
  }

  .post-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .post-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .post-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .post-year {
    font-size: 0.875rem;
    color: #6b7280;
    flex-shrink: 0;
  }

  .post-source {
    font-size: 0.75rem;
    color: #9ca3af;
  }

  .post-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #374151;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin-top: 0.25rem;
  }

  .post-tag {
    font-size: 0.7rem;
    border: 1px solid #d1d5db;
    padding: 0.15rem 0.5rem;
    color: #374151;
  }

  .post-link {
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.875rem;
    color: #3b82f6;
    font-weight: 500;
  }
</style>
