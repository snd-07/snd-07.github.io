    color: #3b82f6;
  }

  .about-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2.5rem;
  }

  .about-title {
    font-size: 2.25rem;
    font-weight: 700;
  }

  .about-subtitle {
    font-size: 0.875rem;
