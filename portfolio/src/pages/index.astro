    font-size: 0.875rem;
    color: #6b7280;
    flex-shrink: 0;
  }

  .post-source {
    font-size: 0.75rem;
    color: #9ca3af;
  }

  .post-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #374151;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
