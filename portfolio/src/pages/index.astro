---
import Layout from '../layouts/Layout.astro';
import articles from '../data/articles.json';

const isExternal = (url: string) => url.startsWith('http');
---

<Layout title="sono's portfolio" showContact={true}>
  <div class="mx-auto max-w-[61.25rem] w-full px-4 pb-32 md:pb-52 md:mt-16 mt-8">
    <section class="h-[20rem] flex flex-col justify-center self-center">
      <p class="text-4xl font-bold">sono's</p>
      <p class="text-7xl md:text-9xl font-bold break-all">portfolio</p>
    </section>
    <section class="mt-24 md:mt-40">
      <h2 class="text-3xl font-bold">クライアントワーク</h2>
      <ul class="grid gap-x-3 gap-y-8 grid-cols-1 flex-wrap mt-6 md:grid-cols-3 md:gap-y-16 md:mt-9">
        {articles.client.map((item) => (
          <li>
            <a href={item.href} target={isExternal(item.href) ? '_blank' : undefined} rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}>
              <img src={item.imgSrc} width="1280" class="rounded-lg" />
              <h3 class="mt-4 font-bold text-base">{item.title}</h3>
              {item.category && item.time ? (
                <p class="mt-2 text-xs text-gray-400">{item.category} | {item.time}</p>
              ) : null}
            </a>
          </li>
        ))}
      </ul>
    </section>
    <section class="mt-24 md:mt-40">
      <h2 class="text-3xl font-bold">共同制作</h2>
      <ul class="grid gap-x-3 gap-y-8 grid-cols-1 flex-wrap mt-6 md:grid-cols-3 md:gap-y-16 md:mt-9">
        {articles.collaboration.map((item) => (
          <li>
            <a href={item.href} target={isExternal(item.href) ? '_blank' : undefined} rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}>
              <img src={item.imgSrc} width="1280" class="rounded-lg" />
              <h3 class="mt-4 font-bold text-base">{item.title}</h3>
              {item.category && item.time ? (
                <p class="mt-2 text-xs text-gray-400">{item.category} | {item.time}</p>
              ) : null}
            </a>
          </li>
        ))}
      </ul>
    </section>
    <section class="mt-24 md:mt-40">
      <h2 class="text-3xl font-bold">Qiita</h2>
      <ul class="grid gap-x-3 gap-y-8 grid-cols-1 flex-wrap mt-6 md:grid-cols-3 md:gap-y-16 md:mt-9">
        {articles.qiita.map((item) => (
          <li>
            <a href={item.href} target={isExternal(item.href) ? '_blank' : undefined} rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}>
              <img src={item.imgSrc} width="1280" class="rounded-lg" />
              <h3 class="mt-4 font-bold text-base">{item.title}</h3>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <section class="mt-24 md:mt-40">
      <h2 class="text-3xl font-bold">note</h2>
      <ul class="grid gap-x-3 gap-y-8 grid-cols-1 flex-wrap mt-6 md:grid-cols-3 md:gap-y-16 md:mt-9">
        {articles.note.map((item) => (
          <li>
            <a href={item.href} target={isExternal(item.href) ? '_blank' : undefined} rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}>
              <img src={item.imgSrc} width="1280" class="rounded-lg" />
              <h3 class="mt-4 font-bold text-base">{item.title}</h3>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <section class="mt-24 md:mt-40">
      <h2 class="text-3xl font-bold">sonoについて</h2>
      <div
        class="flex justify-between md:items-center flex-col-reverse items-start md:gap-y-8 mt-8 md:gap-y-0 md:mt-0 md:flex-row"
      >
        <div class="mt-10">
          <p class="text-base">
            1996年生まれ 名古屋市在住のWebデザイナー。<br>UIデザイン、HTML、CSSが好きです。</p>
          <a href="/profile.html" class="rounded-3xl border-black border-solid border py-3 px-8 inline-block mt-10 mr-4 inline-flex items-center transition-colors duration-300 ease-in-out
          hover:bg-black hover:text-white"
          >プロフィールを詳しく見る<span class="ml-1">→</span></a>
        </div>
        <img src="/images/icon.webp" width="200" class="rounded-full" />
      </div>
    </section>
  </div>
</Layout>
