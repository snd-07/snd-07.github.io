    margin-top: 6rem;
    padding-bottom: 6rem;
  }

  @media (min-width: 768px) {
    .about-section {
      margin-top: 10rem;
    }
  }

  .about-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .about-rule {
    display: block;
    width: 1.75rem;
    height: 2px;
    background-color: #3b82f6;
    flex-shrink: 0;
  }

  .about-eyebrow-label {
    font-size: 0.7rem;
