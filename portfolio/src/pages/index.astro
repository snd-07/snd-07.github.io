---
import Layout from '../layouts/Layout.astro';
import articles from '../data/articles.json';
import icon from '../assets/icon.jpg';
import type { ImageMetadata } from 'astro';

const isExternal = (url: string) => url.startsWith('http');

const assetImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/**/*.{png,jpg,jpeg,webp}',
  { eager: true }
);
const resolveImage = (imgSrc: string) =>
  assetImages[imgSrc.replace('/images', '../assets')].default.src;

const allLabels = [...new Set(articles.works.map((item) => item.label))];
const allTags = [...new Set(articles.works.flatMap((item) => item.tags))];
const updatedAt = '2025.07';
---

<Layout title="sono's portfolio" showContact={true}>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;700;900&display=swap" />
  <div class="page-wrapper">
    <section class="hero">
      <p class="hero-title">sono's <br>portfolio</p>
      <p class="hero-text">名古屋市在住のWebデザイナー、<br>sonoのポートフォリオです。<br></p>
      <div class="hero-meta">
        <p class="work-status work-status--available">
          <span class="work-status__dot"></span>ご依頼受付中 ({updatedAt}更新)
        </p>
      </div>
    </section>
    <section class="works-section">
      <div class="filter-bar" id="filter-bar">
        <div class="filter-group">
          <p class="filter-group-label">カテゴリ</p>
          <ul class="filter-groupList">
            <li>
              <button class="filter-btn active" data-tag="all">すべて</button>
            </li>
            {allLabels.map((label) => (
            <li>
              <button class="filter-btn" data-tag={label}>{label}</button>
            </li>
            ))}
          </ul>
        </div>
        <div class="filter-group">
          <p class="filter-group-label">タグ</p>
          <ul class="filter-groupList">
          {allTags.map((tag) => (
            <li>
              <button class="filter-btn filter-btn--tag active" data-tag={tag}>#{tag}</button>
            </li>
          ))}
          </ul>
        </div>
      </div>
      <ul class="posts-list" id="works-grid">
        {articles.works.map((item) => (
          <li class="post-card" data-label={item.label} data-tags={item.tags.join(',')}>
            <a href={item.href} target={isExternal(item.href) ? '_blank' : undefined} rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}>
              <div class="post-img-wrap">
                <img src={resolveImage(item.imgSrc)} class="post-img" />
              </div>
              <div class="post-body">
                <div class="post-meta-row">
                  <span class="post-label">{item.label}</span>
                  <h3 class="post-title">{item.title}</h3>
                </div>
                <p class="post-desc">{item.description}</p>
                <ul class="post-tags">
                  {item.tags.map((tag) => (
                    <li class="post-tag">#{tag}</li>
                  ))}
                </ul>
                  <p class="post-source"><span>{item.year}</span></p>
                <span class="post-link">→</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="about-section" id="about">
      <div class="about-body">
        <div class="about-portrait-wrap">
          <img src={icon.src} class="about-portrait" alt="sono portrait" />
        </div>
        <div class="about-content">
        <h3 class="detail-heading">自己紹介</h3>
        <h4 class="acc-h3">sono</h4>
         <p class="about-desc">1996年生まれ。愛知県で暮らしています。</p>
         <p class="about-desc">名古屋学芸大学 メディア造形学部 デザイン学科出身。<br>在学中にビジュアルデザインを学ぶ中で、Webデザイン、サービスデザインに興味を持つように。</p>
         <p class="about-desc">2019年に株式会社エイチームに入社し、Webデザイナーとしてのキャリアをスタート。<br>2025年に退社し、現在はさまざまなWebデザイン業務に携わっています。</p>
          <div class="accordion" id="about-detail">
            <div class="about-detail" id="about-detail">
  <div class="detail-section">
    <h3 class="detail-heading">得意なこと</h3>
    <div class="detail-body">
      <h4 class="acc-h3">機能的なデザインを作ること</h4>
      <p>使いやすさや実用性を重視したデザインが得意です。</p>
      <p>目的がスムーズに達成できる・一貫性のあるデザインを作るために、論理的に考える傾向があり、装飾や見た目のインパクトよりも、「ユーザーが迷わず目的を達成できるか」を優先して考えます。</p>
      <p>一方で、イラストやグラフィカルな表現など、感覚や情緒に訴えるデザインは苦手です。自分の強みが活きるのは、「機能」と「わかりやすさ」を軸にしたデザインだと考えています。</p>
      <h4 class="acc-h3">デザインとコードをつなぐこと</h4>
      <p>Webデザイン・HTMLコーディング、両方を担当できます。<br />
      そのため、「このデザインは実装したときにどう動くか」を考えながらデザインを作ることができます。</p>
      <p>マークアップやスタイリングだけでなく、アコーディオンやフィルター、簡単なアニメーションなど、見た目に関わる動きの実装も行うことが可能です。<br />
      デザインで意図した挙動や質感を、コードの部分まで自分の手で再現できるのが強みです。</p>
      <h4 class="acc-h3">チームのハブになること</h4>
      <p>マーケター・デザイナー・エンジニアで協業してサイト改善を行う経験をしてきました。</p>
      <ul class="acc-list">
        <li>それぞれの立場の要望・観点をふまえて着地を決めること</li>
        <li>チームの共通認識が揃うよう情報の整理・見える化をすること</li>
      </ul>
      <p>この２つが得意です。</p>
    </div>
  </div>

  <div class="detail-section">
    <h3 class="detail-heading">大事にしていること</h3>
    <div class="detail-body">
      <h4 class="acc-h3">プロダクトのフェーズによって「どんなデザインをするべきか？」を考えること</h4>
      <p>事業会社での新規事業・既存事業 両方の経験から、今何を大事にするべきか？バランスを取って行動することを心がけています。</p>
      <p>事業の状況によって、「早く」「小さく」出すことを重要視するタイミングもあれば、妥協しないで高いクオリティでプロダクトを出すタイミングもあると考えており、どちらかが絶対的な正解ではなく、状況に応じた判断ができるように意識しています。</p>
      <p>そのために、下記を具体的に行うようにしています。</p>
      <ul class="acc-list">
        <li>心理的柔軟性をもって対応すること</li>
        <li>譲れないところではきちんと会話すること</li>
      </ul>
    </div>
  </div>
</div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  const categoryBtns = document.querySelectorAll<HTMLButtonElement>('#filter-bar .filter-btn:not(.filter-btn--tag)');
  const tagBtns = document.querySelectorAll<HTMLButtonElement>('#filter-bar .filter-btn--tag');
  const cards = document.querySelectorAll<HTMLElement>('#works-grid .post-card');

  let activeCategory = 'all';
  const activeTags = new Set<string>([...tagBtns].map((b) => b.dataset.tag!));

  function applyFilter() {
    cards.forEach((card) => {
      const label = card.dataset.label ?? '';
      const tags = card.dataset.tags?.split(',').filter(Boolean) ?? [];
      const categoryMatch = activeCategory === 'all' || label === activeCategory;
      const tagMatch = activeTags.size === 0 || tags.some((t) => activeTags.has(t));
      card.style.display = categoryMatch && tagMatch ? '' : 'none';
    });
  }

  categoryBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.tag!;
      categoryBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      applyFilter();
    });
  });

  tagBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag!;
      if (activeTags.has(tag)) {
        activeTags.delete(tag);
        btn.classList.remove('active');
      } else {
        activeTags.add(tag);
        btn.classList.add('active');
      }
      applyFilter();
    });
  });
</script>

